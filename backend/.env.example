# Copy to backend/.env for local development. All variables are optional.
ISSUE_TRIAGE_APP_NAME="AI Issue Triage"
ISSUE_TRIAGE_ENVIRONMENT=development   # development | test | production
ISSUE_TRIAGE_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
# Where raw GitHub data is stored (git-ignored). Defaults to <repo>/data.
# ISSUE_TRIAGE_DATA_DIR=../data
# GitHub token for ingestion; falls back to `gh auth token` when unset.
# ISSUE_TRIAGE_GITHUB_TOKEN=
# Salt for username pseudonyms (D-003). Change it for any shared dataset.
# ISSUE_TRIAGE_PSEUDONYM_SALT=local-dev-salt
# PostgreSQL (docker compose up -d db). Demo credentials only.
# ISSUE_TRIAGE_DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5433/issue_triage
