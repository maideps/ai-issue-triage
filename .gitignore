# Generic ignores for harness-enabled projects.
# Add project-specific ignores below — this file is project-owned (INSTANCE).

# Harness runtime traces (session records are local state, not evidence)
.harness/traces/*.json

# Harness upgrade backups — a local safety net, not durable evidence
.harness/backups/

# Node projects
node_modules/

# Windows reserved device names (shell redirect artifacts)
nul
NUL

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Secrets
.env

# Raw GitHub data stays local (D-003); only small samples under evals/ are committed
data/

# Frontend build output
frontend/dist/
*.tsbuildinfo
